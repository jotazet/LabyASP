@model Lab0.Models.Car

@{
    ViewData["Title"] = "Szczegóły Samochodu";
}

<h2>Szczegóły Samochodu</h2>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Model:</dt>
            <dd class="col-sm-9">@Model.Model</dd>

            <dt class="col-sm-3">Producent:</dt>
            <dd class="col-sm-9">@Model.Manufacturer</dd>

            <dt class="col-sm-3">Pojemność silnika:</dt>
            <dd class="col-sm-9">@Model.EngineCapacity l</dd>

            <dt class="col-sm-3">Moc:</dt>
            <dd class="col-sm-9">@Model.Power KM</dd>

            <dt class="col-sm-3">Rodzaj silnika:</dt>
            <dd class="col-sm-9">@Model.EngineType</dd>

            <dt class="col-sm-3">Nr rejestracyjny:</dt>
            <dd class="col-sm-9">@Model.RegistrationNumber</dd>

            <dt class="col-sm-3">Właściciel:</dt>
            <dd class="col-sm-9">@Model.Owner</dd>
        </dl>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">Powrót do listy</a>
</div>