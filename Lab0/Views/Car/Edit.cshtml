@model Lab0.Models.Car

@{
    ViewData["Title"] = "Edytuj Samochód";
}

<h2>Edytuj Samochód</h2>

<form asp-action="Edit" asp-route-registrationNumber="@Model.RegistrationNumber" method="post">
    <div class="form-group">
        <label asp-for="Model"></label>
        <input asp-for="Model" class="form-control" />
        <span asp-validation-for="Model" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Manufacturer"></label>
        <input asp-for="Manufacturer" class="form-control" />
        <span asp-validation-for="Manufacturer" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="EngineCapacity"></label>
        <input asp-for="EngineCapacity" class="form-control" />
        <span asp-validation-for="EngineCapacity" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Power"></label>
        <input asp-for="Power" class="form-control" />
        <span asp-validation-for="Power" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="EngineType"></label>
        <input asp-for="EngineType" class="form-control" />
        <span asp-validation-for="EngineType" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="RegistrationNumber"></label>
        <input asp-for="RegistrationNumber" class="form-control" disabled />
    </div>
    <div class="form-group">
        <label asp-for="Owner"></label>
        <input asp-for="Owner" class="form-control" />
        <span asp-validation-for="Owner" class="text-danger"></span>
    </div>
    <div class="form-group mb-3">
        <label asp-for="CompanyId" class="form-label">Firma</label>
        <select asp-for="CompanyId" asp-items="ViewBag.Companies" class="form-select">
            <option value="">-- Brak --</option>
        </select>
    </div>
    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Zapisz</button>
        <a asp-action="Details" asp-route-registrationNumber="@Model.RegistrationNumber" class="btn btn-secondary">Anuluj</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
